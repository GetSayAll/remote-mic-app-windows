+    pub fn repeat_interval(self) -> Option<Duration> {
+        match self {
+            Self::Back => Some(Duration::from_millis(50)),
+            Self::Up
+            | Self::Down
+            | Self::Left
+            | Self::Right
+            | Self::VolumeUp
+            | Self::VolumeDown => Some(Duration::from_millis(100)),
+            Self::Ok | Self::Tv | Self::Home | Self::Menu | Self::Power | Self::VolumeMute => None,
+        }
+    }
