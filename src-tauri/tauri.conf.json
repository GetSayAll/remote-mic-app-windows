{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "无线麦 SayAll",
  "version": "0.1.0",
  "identifier": "app.getsayall.remote-mic.windows",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:2430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "无线麦 SayAll",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
